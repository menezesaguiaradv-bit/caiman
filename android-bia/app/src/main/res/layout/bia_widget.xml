  android:gravity="center_vertical" android:background="@drawable/widget_fundo" android:paddingStart="10dp" android:paddingEnd="8dp">
  <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@mipmap/ic_launcher" android:contentDescription="Bia" />
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="12dp"
    android:text="Pergunte à Bia" android:textColor="#E3C9B8" android:textSize="16sp" android:singleLine="true" />
  <ImageView android:id="@+id/w_mic" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp"
    android:src="@drawable/widget_mic" android:contentDescription="Falar com a Bia" />
</LinearLayout>
